# deep-daily instance API keys. Copy to `<HOME>/.env` and fill in.
# This file is deliberately kept minimal — add more as downstream integrations
# demand them.

# LLM endpoint (OpenAI-compatible HTTP). Required.
LLM_API_BASE=
LLM_API_KEY=

# LiteLLM multi-key round-robin (optional; used when llm.backend=multikey)
# Provide one or more keys separated by newlines, or leave blank.
LITELLM_API_BASE=
LITELLM_API_KEYS=

# Feishu webhook (optional; only if publisher.feishu.enabled=true in config.yaml)
FEISHU_WEBHOOK=

# Session-memory source override (optional). Leave blank to use
# <HOME>/data/.session-memory, which is the isolated per-instance default.
SESSION_MEMORY_DIR=
