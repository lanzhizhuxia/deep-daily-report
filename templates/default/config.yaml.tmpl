# deep-daily instance config. Rendered by `deep-daily init` from
# templates/default/config.yaml.tmpl. Safe to edit after init.
#
# After init, the literal placeholder tokens (reader_name, llm_backend,
# feishu_enabled, created_at, tool_version) below are replaced with
# concrete values; this file is no longer a template once rendered.

schema_version: 1

instance:
  name: "{reader_name}"
  description: "Daily digest instance for {reader_name}"
  created_at: "{created_at}"
  tool_version: "{tool_version}"

# Per-step model IDs. Resolution precedence (first non-empty wins):
#   WRITE:    --model CLI  >  $DAILY_WRITE_MODEL    >  models.write     >  built-in default
#   FILTER:                   $DAILY_FILTER_MODEL   >  models.filter    >  built-in default
#   CLUSTER:                  $DAILY_CLUSTER_MODEL  >  models.cluster   >  built-in default
#   APPENDIX:                 $DAILY_APPENDIX_MODEL >  models.appendix  >  built-in default
# Built-in defaults live in deep_daily.config.DEFAULT_MODELS (source of truth).
models:
filter: "deepseek-v4-flash"
cluster: "deepseek-v4-flash"
write: "gemini-3.1-pro-preview"
appendix: "gpt-5.4-mini"

llm:
  backend: "{llm_backend}"

reader:
  name: "{reader_name}"
  notify:
    topic_id: "{reader_name}.daily-report"
    event_id: "daily_report_ready"
    dedupe_prefix: "daily_report_{reader_name}"

profile:
  auto_refresh: false
  max_age_hours: 168

collectors:
  rss:
    enabled: true
    per_source_cap: 10
  twitter:
    enabled: true
    long_threshold: 400
    lane_cap_normal: 15
    lane_cap_long: 8
  twitter_nas:
    enabled: false
  news_6551:
    enabled: false

pipeline:
  cleanup_max_age_days: 14
  reported_events_ttl_days: 7
  ongoing_cap_per_topic: 1
  title_sim_match_threshold: 0.7

publisher:
  default: "file"
  feishu:
    enabled: {feishu_enabled}
    webhook_env: "FEISHU_WEBHOOK"
